# ---------- Supabase (majburiy) ----------
# Ma'lumotlar (murojaat, yangilik, jamoa, sahifa matnlari, rasm manzillari)
# va yuklangan fayllar Supabase'da saqlanadi.
#
# Supabase dashboard → Project Settings → API bo'limidan oling.
SUPABASE_URL=https://xxxxxxxx.supabase.co

# DIQQAT: bu YASHIRIN kalit (service_role / sb_secret_...).
# U barcha ma'lumotlarga to'liq huquq beradi va RLS ni chetlab o'tadi.
# Hech qachon brauzerga chiqarmang, repozitoriyga qo'ymang, chatga tashlamang.
# anon / publishable kalit bu loyihada umuman kerak emas.
SUPABASE_SERVICE_ROLE_KEY=

# Birinchi ishga tushirishdan oldin supabase/schema.sql ni
# Supabase dashboard → SQL Editor da bir marta ishga tushiring.

# ---------- Admin ----------
# /admin sahifasi va admin API uchun parol.
# Sozlanmasa admin API butunlay yopiq bo'ladi (503).
ADMIN_PASSWORD=

# ---------- Telegram (ixtiyoriy) ----------
# Bo'sh qolsa murojaat faqat bazaga saqlanadi, xabar yuborilmaydi.
# @BotFather dan bot yarating va tokenni shu yerga qo'ying
TELEGRAM_BOT_TOKEN=
# Xabar boradigan chat: shaxsiy chat ID yoki guruh ID (masalan -1001234567890)
TELEGRAM_CHAT_ID=

# ---------- Fayl yuklash ----------
# Admin yuklaydigan fayllar uchun hajm chegarasi (MB). Default: rasm 15, video 100.
# MAX_IMAGE_MB=15
# MAX_VIDEO_MB=100

# ---------- Qolganlari ----------
# Saytning to'liq manzili (OG rasmlar va canonical uchun)
# NEXT_PUBLIC_SITE_URL=https://uzgrow.uz

# Rate limiting IP ni x-forwarded-for sarlavhasidan oladi. Render/Vercel kabi
# proksi orqasida bu to'g'ri. Server to'g'ridan-to'g'ri internetga qarasa,
# sarlavhani soxtalashtirib limitni aylanib o'tish mumkin — u holda:
# TRUST_PROXY=false
